# DISABLED, operator-reviewed drop-in example; systemd >=250 for encrypted form.
# Source encrypted blobs are provisioned OUT OF BAND, never by application startup.
# Replace placeholders, repeat key lines only for currently approved nonrevoked kids.
[Service]
LoadCredentialEncrypted=classification-aead.json:<APPROVED_ENCRYPTED_MANIFEST_PATH>
LoadCredentialEncrypted=classification-key-<APPROVED_KID>:<APPROVED_ENCRYPTED_KEY_PATH>
# systemd provides CREDENTIALS_DIRECTORY path; no raw key environment variable.
# >=247 plain LoadCredential alternative REQUIRES separate custody approval and
# protected root-only source files/encrypted storage. Do not uncomment as fallback:
# LoadCredential=classification-aead.json:<APPROVED_ROOT_ONLY_MANIFEST_PATH>
# LoadCredential=classification-key-<APPROVED_KID>:<APPROVED_ROOT_ONLY_KEY_PATH>
# No SetCredential plaintext key, no JWT_SECRET reuse, no generated example bytes.
